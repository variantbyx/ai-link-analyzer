# Provider Selection: 'auto' (Gemini -> Ollama -> Offline Fallback), 'gemini', 'ollama', or 'offline'
LLM_PROVIDER=auto

# Primary Free Cloud Provider (Google Gemini API - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Zero-Budget Local AI Provider (Ollama - No API Key, 100% Free Local Inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Caching (Prevents Re-calling LLM on Repeated URLs, Preserving 100% Quota)
ENABLE_CACHE=true

# Server Configuration
API_HOST=0.0.0.0
API_PORT=4000
